pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest')
    }

    environment {
        DOCKER_REPO = 'azizaroua/formation-service'
        APP_PATH = 'smartfreelance-backend/formation-certification-service'
        K8S_PATH = 'smartfreelance-backend/formation-certification-service/k8s'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t ${DOCKER_REPO}:${params.IMAGE_TAG} ${APP_PATH}"
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh 'echo $PASS | docker login -u $USER --password-stdin'
                }
            }
        }

        stage('Docker Push') {
            steps {
                sh "docker push ${DOCKER_REPO}:${params.IMAGE_TAG}"
            }
        }

        stage('Deploy') {
            steps {
                sh """
                    export KUBECONFIG=/root/.kube/config

                    cp ${K8S_PATH}/deployment.yaml /tmp/deployment.yaml

                    sed -i 's|IMAGE_TAG|${params.IMAGE_TAG}|g' /tmp/deployment.yaml

                    kubectl apply -f /tmp/deployment.yaml
                    kubectl apply -f ${K8S_PATH}/service.yaml
                """
            }
        }

        stage('Verify') {
            steps {
                sh "kubectl get pods -o wide"
                sh "kubectl get svc"
            }
        }
    }

    post {
        always {
            sh "docker logout || true"
        }
    }
}
