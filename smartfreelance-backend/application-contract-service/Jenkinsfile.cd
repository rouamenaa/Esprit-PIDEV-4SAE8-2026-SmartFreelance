pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: "${env.BUILD_NUMBER}", description: 'Image tag passed from CI build number')
  }

  environment {
    SERVICE_DIR     = "smartfreelance-backend/application-contract-service"
    HARBOR_REGISTRY = "harbor.local"
    HARBOR_PROJECT  = "smartfreelance"
    IMAGE_NAME      = "application-contract-service"
    IMAGE_TAG       = "${params.IMAGE_TAG}"
    FULL_IMAGE      = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${IMAGE_NAME}:${IMAGE_TAG}"
    LATEST_IMAGE    = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${IMAGE_NAME}:latest"
    K8S_NAMESPACE   = "default"
    K8S_DEPLOYMENT  = "application-contract-service"
  }

  stages {
    stage("Checkout") {
      steps {
        checkout scm
      }
    }

    stage("Build Docker Image") {
      steps {
        dir("${env.SERVICE_DIR}") {
          sh '''#!/bin/bash
            set -euo pipefail

            if docker info >/dev/null 2>&1; then
              DOCKER_CMD="docker"
            elif sudo -n docker info >/dev/null 2>&1; then
              DOCKER_CMD="sudo -n docker"
            else
              DOCKER_CMD="docker"
            fi

            $DOCKER_CMD version
            $DOCKER_CMD build -t "$FULL_IMAGE" -t "$LATEST_IMAGE" .
          '''
        }
      }
    }

    stage("Push to Harbor") {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "harbor-credentials",
          usernameVariable: "HARBOR_USERNAME",
          passwordVariable: "HARBOR_PASSWORD"
        )]) {
          sh '''#!/bin/bash
            set -euo pipefail

            if docker info >/dev/null 2>&1; then
              DOCKER_CMD="docker"
            elif sudo -n docker info >/dev/null 2>&1; then
              DOCKER_CMD="sudo -n docker"
            else
              DOCKER_CMD="docker"
            fi

            printf '%s\n' "$HARBOR_PASSWORD" | $DOCKER_CMD login "$HARBOR_REGISTRY" -u "$HARBOR_USERNAME" --password-stdin
            $DOCKER_CMD push "$FULL_IMAGE"
            $DOCKER_CMD push "$LATEST_IMAGE"
            $DOCKER_CMD logout "$HARBOR_REGISTRY" || true
          '''
        }
      }
    }

    stage("Deploy to Kubernetes") {
      steps {
        withCredentials([file(credentialsId: "kubeconfig-application-contract-service", variable: "KUBECONFIG_FILE")]) {
          dir("${env.SERVICE_DIR}") {
            sh '''#!/bin/bash
              set -euo pipefail
              chmod +x scripts/jenkins-k8s-deploy.sh
              ./scripts/jenkins-k8s-deploy.sh
            '''
          }
        }
      }
    }
  }

  post {
    always {
      sh '''#!/bin/bash
        set -e

        if docker info >/dev/null 2>&1; then
          DOCKER_CMD="docker"
        elif sudo -n docker info >/dev/null 2>&1; then
          DOCKER_CMD="sudo -n docker"
        else
          DOCKER_CMD="docker"
        fi

        $DOCKER_CMD image rm "$FULL_IMAGE" "$LATEST_IMAGE" || true
      '''
    }
  }
}